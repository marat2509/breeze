---
import '../styles/globals.css';
import { ClientRouter } from 'astro:transitions';
import { resolveLocaleFromRequest, type Locale } from '../i18n/locales';
import { translate } from '../i18n/resources';

interface Props {
  title: string;
  locale?: Locale;
}

const { title, locale: propLocale } = Astro.props;
const locale = propLocale ?? resolveLocaleFromRequest(Astro.request);
const description = translate(locale, 'app.metaDescription');
const titleSuffix = translate(locale, 'app.titleSuffix');
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <!--
      Theme bootstrap is an external script (not is:inline) so it's covered by
      script-src 'self' under the strict hash-based CSP. Keeping it inline would
      require maintaining a sha256 in astro.config.mjs that drifts every time
      the script changes (see issue #618).
    -->
    <script is:inline src="/theme-bootstrap.js"></script>
    <title>{title} | {titleSuffix}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-background antialiased">
    <slot />
  </body>
</html>
