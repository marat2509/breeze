---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import AiUsagePage from '../../components/settings/AiUsagePage';
import { resolveLocaleFromRequest } from '../../i18n/locales';
import { translate } from '../../i18n/resources';

const locale = resolveLocaleFromRequest(Astro.request);
---

<DashboardLayout title={translate(locale, 'settings.aiUsage.title')} locale={locale}>
  <AiUsagePage locale={locale} client:load />
</DashboardLayout>
