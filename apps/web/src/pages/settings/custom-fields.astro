---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import CustomFieldsPage from '../../components/settings/CustomFieldsPage';
import { resolveLocaleFromRequest } from '../../i18n/locales';
import { translate } from '../../i18n/resources';

const locale = resolveLocaleFromRequest(Astro.request);
---

<DashboardLayout title={translate(locale, 'settings.customFields.title')} locale={locale}>
  <CustomFieldsPage locale={locale} client:load />
</DashboardLayout>
