---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ConnectedAppsList from '../../components/settings/ConnectedAppsList';
import McpUrlCard from '../../components/shared/McpUrlCard';
import { resolveLocaleFromRequest } from '../../i18n/locales';
import { translate } from '../../i18n/resources';

const locale = resolveLocaleFromRequest(Astro.request);
---

<DashboardLayout title={translate(locale, 'account.connectedApps.title')} locale={locale}>
  <div class="mx-auto w-full max-w-4xl space-y-6">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight">{translate(locale, 'account.connectedApps.title')}</h1>
      <p class="mt-1 text-sm text-muted-foreground">
        {translate(locale, 'settings.connectedApps.description')}
      </p>
    </div>
    <McpUrlCard client:only="react" />
    <ConnectedAppsList client:only="react" />
  </div>
</DashboardLayout>
