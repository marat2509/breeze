---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import EnrollmentKeyManager from '../../components/settings/EnrollmentKeyManager';
import { resolveLocaleFromRequest } from '../../i18n/locales';
import { translate } from '../../i18n/resources';

const locale = resolveLocaleFromRequest(Astro.request);
---

<DashboardLayout title={translate(locale, 'settings.enrollmentKeys.title')} locale={locale}>
  <EnrollmentKeyManager locale={locale} client:load />
</DashboardLayout>
