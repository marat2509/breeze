---
import Layout from '../../layouts/Layout.astro';
import AuthOverlay from '../../components/auth/AuthOverlay';
import ToastContainer from '../../components/shared/Toast';
import MobileDevicesPage from '../../components/account/MobileDevicesPage';
import { resolveLocaleFromRequest } from '../../i18n/locales';
import { translate } from '../../i18n/resources';

const locale = resolveLocaleFromRequest(Astro.request);
---

<Layout title={translate(locale, 'account.mobileDevices.title')} locale={locale}>
  <AuthOverlay client:load />
  <MobileDevicesPage client:load />
  <ToastContainer client:load />
</Layout>
